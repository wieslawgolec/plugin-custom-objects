{% extends '@MauticCore/Default/content.html.twig' %}
{% block headerTitle %}New Custom Object{% endblock %}
{% block content %}
<div class="panel panel-default"><div class="panel-body">
<form id="custom-object-form" method="post" action="{{ path('mautic_customobjects_object_new') }}" data-json-submit="1">
    <div class="row">
        <div class="col-md-4"><div class="form-group"><label>Identifier</label><input type="text" name="name" class="form-control" required pattern="[A-Za-z][A-Za-z0-9_]*" placeholder="vehicles"></div></div>
        <div class="col-md-4"><div class="form-group"><label>Singular</label><input type="text" name="singular" class="form-control" required placeholder="Vehicle"></div></div>
        <div class="col-md-4"><div class="form-group"><label>Plural</label><input type="text" name="plural" class="form-control" required placeholder="Vehicles"></div></div>
    </div>
    <h4>Fields</h4>
    <table class="table table-bordered" id="fields-table"><thead><tr><th>Field ID</th><th>Label</th><th>Type</th><th></th></tr></thead>
    <tbody id="fields-body"></tbody></table>
    <button type="button" class="btn btn-default" id="add-field-row"><i class="fa fa-plus"></i> Add field</button>
    <hr><button type="submit" class="btn btn-primary">Save</button>
</form></div></div>
<script src="{{ asset('plugins/CustomObjectsBundle/Assets/js/field-builder.js') }}"></script>
<script>document.addEventListener('DOMContentLoaded', function () { CustomObjectsFieldBuilder.init({ fieldTypes: {{ fieldTypes|default(['string','integer','text','boolean','datetime','float','bigint'])|json_encode|raw }} }); });</script>
{% endblock %}
