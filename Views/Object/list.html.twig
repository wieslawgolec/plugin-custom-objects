{% extends '@MauticCore/Default/content.html.twig' %}
{% block headerTitle %}{{ 'customobjects.objects'|trans|default('Custom Objects') }}{% endblock %}
{% block content %}
<div class="panel panel-default">
    <div class="panel-heading"><h3 class="panel-title">{{ 'customobjects.objects'|trans|default('Custom Objects') }}
        <a href="{{ path('mautic_customobjects_object_new') }}" class="btn btn-primary btn-sm pull-right"><i class="fa fa-plus"></i> New</a></h3></div>
    <div class="panel-body">{% if objects is empty %}<p class="text-muted">No custom objects defined yet.</p>{% else %}
        <table class="table table-hover"><thead><tr><th>Name</th><th>Singular</th><th>Plural</th><th>Fields</th><th></th></tr></thead>
        <tbody>{% for obj in objects %}<tr>
            <td><a href="{{ path('mautic_customobjects_item_index', {objectName: obj.name}) }}">{{ obj.name }}</a></td>
            <td>{{ obj.singular }}</td><td>{{ obj.plural }}</td><td>{{ obj.fields|length }}</td>
            <td class="text-right"><a href="{{ path('mautic_customobjects_export_csv', {objectName: obj.name}) }}" class="btn btn-xs btn-default"><i class="fa fa-download"></i></a></td>
        </tr>{% endfor %}</tbody></table>{% endif %}</div></div>
{% endblock %}
