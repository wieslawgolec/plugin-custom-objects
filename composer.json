{
    "name": "wieslawgolec/plugin-custom-objects",
    "description": "Custom Objects (Custom Tables) Engine for Mautic 7.2+ — dynamic Doctrine schema for infinite One-to-Many relational entities linked to Contacts",
    "type": "mautic-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Wieslaw Golec"
        }
    ],
    "require": {
        "php": "^8.1",
        "mautic/core-lib": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "doctrine/dbal": "^3.0|^4.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0"
    },
    "extra": {
        "mautic-plugin-name": "CustomObjectsBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\CustomObjectsBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\CustomObjectsBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    }
}
